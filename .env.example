# Copy this file to backend/.env and fill in your values.
# NEVER commit .env — it contains real secrets.

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_LLM_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX_NAME=kt-doc-index-v2
PINECONE_ENVIRONMENT=us-east-1-aws

# ── SQLite ────────────────────────────────────────────────────────────────────
SQLITE_DB_PATH=./data/kt_agent.db

# ── Application ───────────────────────────────────────────────────────────────
APP_SECRET_KEY=change-me-to-a-random-string
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
